<view class="container history-page">
  <view class="page-title">掷骰记录</view>
  <view class="page-subtitle">每次结果都保存在本机，随时查看</view>

  <view wx:if="{{records.length}}" class="record-list">
    <block wx:for="{{records}}" wx:key="id">
      <view class="record-card card">
        <view class="record-top">
          <view class="record-icon">⚄</view>
          <view class="record-name">{{item.count}} 颗骰子</view>
          <view class="record-time">{{item.timeLabel}}</view>
        </view>
        <view class="record-bottom">
          <view class="record-values">{{item.valuesText}}</view>
          <view class="record-total">合计 <text>{{item.total}}</text> 点</view>
        </view>
      </view>
    </block>
  </view>

  <view wx:else class="empty card">
    <view class="empty-icon">⚄</view>
    <view class="empty-title">还没有投掷记录</view>
    <view class="empty-desc">投一次骰子，结果就会出现在这里。</view>
    <button class="empty-button" bindtap="onTryDice">去掷骰子</button>
  </view>
</view>
