.page-title { margin-top: 26rpx; font-size: 48rpx; font-weight: 700; }
.page-subtitle { margin-top: 14rpx; color: #8a94a6; font-size: 24rpx; }
.record-list { margin-top: 42rpx; }
.record-card { margin-bottom: 20rpx; padding: 24rpx; }
.record-top { display: flex; align-items: center; }
.record-icon { display: flex; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; margin-right: 18rpx; border-radius: 18rpx; background: #fff0f1; color: #ef5b64; font-size: 38rpx; }
.record-name { flex: 1; color: #27334b; font-size: 28rpx; font-weight: 700; }
.record-time { color: #9aa4b5; font-size: 21rpx; }
.record-bottom { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid #eef1f6; }
.record-values { flex: 1; margin-right: 18rpx; color: #6f7b91; font-size: 25rpx; word-break: break-all; }
.record-total { color: #8390a6; font-size: 23rpx; white-space: nowrap; }
.record-total text { margin: 0 4rpx 0 6rpx; color: #ef5b64; font-size: 36rpx; font-weight: 700; }
.empty { margin-top: 44rpx; padding: 64rpx 24rpx; text-align: center; }
.empty-icon { color: #ef5b64; font-size: 70rpx; }
.empty-title { margin-top: 20rpx; color: #29344a; font-size: 30rpx; font-weight: 700; }
.empty-desc { margin-top: 12rpx; color: #9aa4b5; font-size: 23rpx; }
.empty-button { width: 260rpx; margin-top: 38rpx; border-radius: 18rpx; background: #2563eb; color: #fff; font-size: 26rpx; }
.empty-button::after { border: 0; }
