.profile-head { display: flex; align-items: center; padding: 48rpx 8rpx 56rpx; }.avatar { width: 100rpx; height: 100rpx; display: flex; align-items: center; justify-content: center; margin-right: 24rpx; border-radius: 32rpx; background: #2563eb; color: #fff; font-size: 38rpx; font-weight: 700; }.profile-title { font-size: 40rpx; font-weight: 700; }.profile-subtitle { margin-top: 10rpx; color: #8a94a6; font-size: 24rpx; }.menu { padding: 0 24rpx; }.menu-row { display: flex; align-items: center; min-height: 112rpx; border-bottom: 1rpx solid #eef1f6; }.menu-row:last-child { border-bottom: 0; }.menu-icon { width: 52rpx; color: #2563eb; font-size: 30rpx; }.menu-label { flex: 1; font-size: 28rpx; }.menu-arrow { color: #b7c0ce; font-size: 36rpx; }.version { margin-top: 38rpx; text-align: center; color: #a0a9b8; font-size: 22rpx; }
