page {
  background: #f6f8fc;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(28, 48, 86, 0.06);
}

.muted { color: #8a94a6; }
.primary { color: #2563eb; }
